"""
The workspace: issues, the conversation on them, and everything that has happened on a project.

It is also where the fleet becomes visible to a person. The activity feed is not only this service's own work —
when the documents service changes a file, that reaches here over the relay and shows up in the feed, which is why
`DocumentChanged` is declared below without this service ever raising it.
"""

entity Member {
  id: ID
  name: String
  title: String?
  email: String?
}

enum IssueState { open, doing, done }

"""How soon. `urgent` sorts first on every screen; `normal` is what an issue gets unless someone says otherwise."""
enum Priority { low, normal, high, urgent }

entity Issue @allow(read: viewer != null) {
  id: ID
  projectId: ID
  title: String
  state: IssueState
  assignee: Member?
  priority: Priority
  """Free text, as many as the project likes. Filter the list by one."""
  labels: [String]
  """The day it is due, if a day was set. Past it and not done is overdue."""
  dueOn: Date?
  description: String?
  """Bumped on every change. Send it back as ifVersion so a move cannot land on top of someone else's."""
  version: Int @version
  updatedAt: Instant
}

"""
What to change on an issue. A field that is absent stays as it is; one that is sent replaces what was there, and null
clears the ones that may be empty. That is the protocol's rule for absent arguments (spec 03 §2), so a form sends
only what its person touched and two people editing different fields at once both land. Every field is nullable
here because a required one would have to be sent every time; the command refuses null on the three that cannot be
empty.
"""
input IssueChanges {
  title: String? @range(min: 1, max: 200)
  description: String? @range(max: 20000)
  priority: Priority?
  labels: [String]?
  dueOn: Date?
}

"""One person's share of a project's issues, for the people page."""
object Workload {
  member: Member
  open: Int
  doing: Int
  done: Int
  """Not done and past their due day."""
  overdue: Int
}

entity Comment @allow(read: viewer != null) {
  id: ID
  issueId: ID
  body: String
  at: Instant
  by: Member
}

"""One line of what has happened on a project, whichever service it happened in."""
entity Activity @allow(read: viewer != null) {
  id: ID
  projectId: ID
  """Which service this came from: `workspace`, or `documents` when it arrived over the relay."""
  source: String
  kind: String
  text: String
  at: Instant
  """Who did it. Absent when the line came from something no person did."""
  by: Member?
}

"""A line in a project's chat: what someone said, when. The conversation nobody files an issue for."""
entity Message @allow(read: viewer != null) {
  id: ID
  projectId: ID
  body: String
  at: Instant
  by: Member
}

"""
Something that happened to you: an issue handed over, a reply on one you hold, a file of yours made searchable.
Yours alone: the policy reads the recipient, so a notification is never seen by anyone else.
"""
entity Notification @cache(maxAge: 0s, scope: private) @allow(read: viewer.id == recipientId) {
  id: ID
  recipientId: ID
  """issue.assigned, comment.added, document.indexed."""
  kind: String
  text: String
  projectId: ID
  issueId: ID?
  at: Instant
  """Null until it has been read."""
  readAt: Instant?
}

error NotFound { id: ID }

"""Raised when a message is said, so an open chat hears it as it happens."""
event Said { projectId: ID, messageId: ID, body: String, byId: ID, byName: String, at: Instant }

"""Raised when a notification is written, carried to the one person it is for."""
event Notified { recipientId: ID, notificationId: ID, kind: String, text: String, projectId: ID, issueId: ID?, at: Instant }

"""Raised here when anything lands on a project's feed, so a stream can carry it without polling the table."""
event ActivityHappened { projectId: ID, source: String, kind: String, text: String, byId: ID? }

event IssueMoved { issueId: ID, from: IssueState, to: IssueState }
event CommentAdded { issueId: ID, commentId: ID }

"""
Raised by the **documents** service, not by this one. Declared here because the relay delivers events by name to
every service in the fleet, and this service reacts to it: a changed document becomes a line in the feed.
"""
event DocumentChanged { documentId: ID, projectId: ID, name: String, version: Int, byId: ID }
"""Three more of the documents service's, heard the same way: filed, tagged, and remarked on."""
event DocumentFiled { documentId: ID, projectId: ID, name: String, folder: String?, byId: ID }
event DocumentTagged { documentId: ID, projectId: ID, name: String, tags: [String], byId: ID }
event DocumentNoted { documentId: ID, projectId: ID, name: String, excerpt: String, byId: ID }
"""The approvals service's, the fleet's JVM member: a sign-off asked, and one decided. Heard here the same way."""
event ApprovalRequested { approvalId: ID, documentId: ID, projectId: ID, documentName: String, requesterId: ID, approverId: ID }
event ApprovalDecided { approvalId: ID, documentId: ID, projectId: ID, documentName: String, decision: String, byId: ID, note: String? }

"""Everyone who can be assigned something, for a picker."""
query members: [Member] @allow(read: viewer != null)

"""Who is asking, as this service knows them: the session made a person, and this is that person's row."""
query me: Member? @allow(read: viewer != null)

"""How the work is spread over the team, across every project. Ask for it `live` and it follows each hand-over."""
query workload: [Workload] @allow(read: viewer != null) @cost(base: 4)

query issue(id: ID): Issue? @allow(read: viewer != null)

"""A project's issues. Each filter narrows; none means all of them."""
query issues(projectId: ID, state: IssueState?, assigneeId: ID?, label: String?, page: PageArgs = { first: 50 }): Page<Issue> @allow(read: viewer != null) @cost(base: 1, perItem: 1)
query comments(issueId: ID, page: PageArgs = { first: 50 }): Page<Comment> @allow(read: viewer != null) @cost(base: 1, perItem: 1)

"""What has happened on this project, newest first. Ask for it `live` and it stays current by itself."""
query activity(projectId: ID, page: PageArgs = { first: 20 }): Page<Activity> @allow(read: viewer != null) @cost(base: 1, perItem: 1)

"""Open an issue. Unassigned and of normal priority unless the arguments say otherwise."""
command createIssue(projectId: ID, title: String @range(min: 1, max: 200), assigneeId: ID?, priority: Priority = normal, labels: [String] = [], dueOn: Date?, description: String?): Issue
  emits ActivityHappened
  @allow(write: viewer != null)

"""Change an issue's fields. Send `ifVersion` as with a move; an edit on top of someone else's is refused."""
command updateIssue(id: ID, changes: IssueChanges): Issue
  throws NotFound
  emits ActivityHappened
  @allow(write: viewer != null)
  @simulate

"""Hand an issue to someone, or to nobody. Send `ifVersion` as with a move. Whoever it went to is notified."""
command assignIssue(id: ID, assigneeId: ID?): Issue
  throws NotFound
  emits ActivityHappened Notified
  @allow(write: viewer != null)
  @simulate

"""Move an issue. Send `ifVersion` with the version you read and a move that would overwrite someone else's is refused."""
command moveIssue(id: ID, to: IssueState): Issue
  throws NotFound
  emits IssueMoved ActivityHappened
  @allow(write: viewer != null)
  @simulate

"""Reply on an issue. Whoever holds the issue is notified, unless the reply is theirs."""
command addComment(issueId: ID, body: String @range(min: 1, max: 4000)): Comment
  throws NotFound
  emits CommentAdded ActivityHappened Notified
  @allow(write: viewer != null)

"""Every line as it lands, without polling. Carries what other services did, too."""
stream activityFeed(projectId: ID): ActivityHappened @allow(read: viewer != null)

"""A project's chat so far, newest last."""
query messages(projectId: ID, page: PageArgs = { first: 50 }): Page<Message> @allow(read: viewer != null) @cost(base: 1, perItem: 1)

"""Say something in a project's chat. Everyone with the chat open hears it through the stream."""
command say(projectId: ID, body: String @range(min: 1, max: 2000)): Message
  emits Said
  @allow(write: viewer != null)

"""Each message as it is said, in order: what a chat is, rather than a list that re-runs."""
stream chat(projectId: ID): Said @allow(read: viewer != null)

"""Your notifications, newest first."""
query notifications(page: PageArgs = { first: 30 }): Page<Notification> @allow(read: viewer != null) @cost(base: 1, perItem: 1)

"""How many of yours are unread. Live, so a badge is right without asking again."""
query unread: Int @allow(read: viewer != null)

"""Each notification for you, as it is written."""
stream notified: Notified @allow(read: viewer != null)

"""
Marks everything of yours up to a moment as read, and says how many that was. Doing it twice is the same as once by
its nature, so it takes no idempotency key — and refuses one, which is what @idempotent(false) means.
"""
command markRead(upTo: Instant): Int @idempotent(false) @allow(write: viewer != null)
