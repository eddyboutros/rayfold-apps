"""
A document store: upload a file, replace it, keep every revision.

The bytes never travel in a batch and never sit in a row. They arrive on the upload route, the command moves them
into the store's own directory, and everything after that names a document by its id and reads its bytes from `url`.
"""

entity Member {
  id: ID
  name: String
}

"""
A file someone keeps here. `url` is where its bytes are; nothing else carries them.

Who may read it is one expression: anyone on the team, or the holder of a share for this document and no other. A
share is a capability token whose viewer carries `documentId` and nothing else, so that second viewer never existed
as an account and cannot be anything but this. Changing a document is its owner's alone; see the commands.
"""
entity Document @cache(maxAge: 0s, scope: private) @allow(read: viewer.documentId == null || viewer.documentId == id) {
  id: ID
  name: String
  """The project it lives in. Everything a person sees is scoped to one."""
  projectId: ID
  """Who it belongs to: the only person who may replace, rename, share or delete it. `owner` below is the same person, loaded."""
  ownerId: ID
  contentType: String
  """Bytes of the current revision."""
  size: Int
  """Where to read the bytes. Serve them from wherever you keep them; this store serves them itself."""
  url: String
  """Bumped on every change. Send it back as ifVersion (or If-Match) so a replace cannot lose someone else's."""
  version: Int @version
  updatedAt: Instant
  owner: Member
  """Where it is filed, as a path like `contracts/2026`; null is the project's root."""
  folder: String?
  """Free words the team puts on it. Filter the list by one."""
  tags: [String]
}

"""A remark on a document, by someone on the team. A share's holder sees none: a link reads the file, not the conversation about it."""
entity Note @allow(read: viewer.documentId == null) {
  id: ID
  documentId: ID
  body: String
  at: Instant
  by: Member
}

"""A folder a project's documents are filed in, and how many are in it."""
object Folder {
  name: String
  count: Int
}

"""What the document was before. Every replace keeps one, so nothing is overwritten in place."""
entity Revision {
  id: ID
  documentId: ID
  version: Int
  size: Int
  url: String
  at: Instant
  by: Member
}

"""A link to one document, for someone who has no account here."""
entity Share {
  id: ID
  documentId: ID
  """The capability token. Hand this to whoever the document is for; it carries its own permission."""
  token: String
  expiresAt: Instant
  """What the holder may do. Reading only, for now."""
  ops: [String]
}

error NotFound { id: ID }
error Forbidden { id: ID }
"""The upload named by a command was never there, or its lifetime ran out before the command arrived."""
error UploadGone { upload: ID }
"""The bytes are over the limit the platform sets for this service. Nothing was kept."""
error UploadTooLarge { size: Int, limit: Int }

"""Raised on every change, with who made it, so another service can say so without asking this one."""
event DocumentChanged { documentId: ID, projectId: ID, name: String, version: Int, byId: ID }
"""Raised when a document is filed somewhere else. `folder` null is the root."""
event DocumentFiled { documentId: ID, projectId: ID, name: String, folder: String?, byId: ID }
event DocumentTagged { documentId: ID, projectId: ID, name: String, tags: [String], byId: ID }
"""Raised when someone remarks on a document, with the start of what they said."""
event DocumentNoted { documentId: ID, projectId: ID, name: String, excerpt: String, byId: ID }

"""Who is asking, as this service knows them. A share's holder is nobody here: a link is not an account."""
query me: Member? @allow(read: viewer != null)

query document(id: ID): Document? @allow(read: viewer != null)
"""The one document a share's token is for. Nobody else has one, so for anyone signed in this is null."""
query shared: Document? @allow(read: viewer.documentId != null)
"""Everything on a project, newest first. A project's files are the team's, not the uploader's. Each filter narrows."""
query documents(projectId: ID, folder: String?, tag: String?, page: PageArgs = { first: 20 }): Page<Document> @allow(read: viewer != null) @cost(base: 1, perItem: 1)
"""The folders a project's documents are filed in, with what each holds. The root is not a folder."""
query folders(projectId: ID): [Folder] @allow(read: viewer != null)
query revisions(documentId: ID, page: PageArgs = { first: 20 }): Page<Revision> @allow(read: viewer != null) @cost(base: 1, perItem: 1)
"""What the team has said about a document, oldest first. Not for a share: a link reads the file, not the talk about it."""
query notes(documentId: ID, page: PageArgs = { first: 50 }): Page<Note> @allow(read: viewer.documentId == null) @cost(base: 1, perItem: 1)

"""Take an upload and keep it as a document. The upload is consumed: its bytes move, they are not copied and left."""
command createDocument(upload: ID, name: String, projectId: ID): Document
  throws UploadGone | UploadTooLarge
  emits DocumentChanged
  @allow(write: viewer != null)

"""
Replace a document's bytes, keeping the old ones as a revision. Send `ifVersion` with the version you read, and a
replace that would land on top of someone else's is refused with `version_conflict` instead.
"""
command replaceContent(id: ID, upload: ID): Document
  throws NotFound | Forbidden | UploadGone | UploadTooLarge
  emits DocumentChanged
  @allow(write: viewer != null)

command renameDocument(id: ID, name: String): Document
  throws NotFound | Forbidden
  emits DocumentChanged
  @allow(write: viewer != null)
  @simulate

"""File a document in a folder, or at the root with null. The owner's to do; send `ifVersion`."""
command moveDocument(id: ID, folder: String? @range(max: 200)): Document
  throws NotFound | Forbidden
  emits DocumentFiled
  @allow(write: viewer != null)
  @simulate

"""Put words on a document. Anyone on the team may: tags are the team's, not the owner's. Send `ifVersion`."""
command tagDocument(id: ID, tags: [String]): Document
  throws NotFound
  emits DocumentTagged
  @allow(write: viewer != null)
  @simulate

"""Say something about a document. Everyone on the team reads it; the project's feed says it happened."""
command addNote(documentId: ID, body: String @range(min: 1, max: 4000)): Note
  throws NotFound
  emits DocumentNoted
  @allow(write: viewer.documentId == null)

"""
Hand someone a link to one document. What comes back is a capability token: it speaks for a viewer that can read
this document and nothing else, it may call only the operations it names, and it stops working when it expires.
No account is created, nothing is stored, and it cannot be widened by whoever holds it.
"""
command shareDocument(id: ID, ttlMs: Int = 3600000 @range(min: 1000, max: 3600000)): Share
  throws NotFound | Forbidden
  @allow(write: viewer != null)

"""Deletes the document, its revisions and their bytes."""
command deleteDocument(id: ID): Document
  throws NotFound | Forbidden
  @allow(write: viewer != null)
