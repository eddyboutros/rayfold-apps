// The catalogue: everything the company knows that is worth finding — what it sells, who works here, and what has
// been written down — behind one search.
//
// Three kinds of thing, one list. `Item` is what they have in common, so a page can hold all of them; `Hit` is what
// a search returns, and a shape says what it wants from each kind with `...on`. Browsing is numbered pages, because
// a person leafing through a catalogue wants page 4 of 12 and not a cursor.

"""What every catalogue entry has in common, so one list can hold any of them."""
object Item @interface {
  id: ID
  name: String
  updatedAt: Instant
}

enum Availability { available, limited, waitlist, retired }

"""Something the company sells. Prices are in cents, as the billing system keeps them."""
entity Product implements Item @cache(maxAge: 60s, scope: public) {
  id: ID
  name: String
  sku: String
  summary: String
  category: String
  """Cents, so a price is an integer everywhere and rounds nowhere."""
  price: Int @unit("EUR cents")
  availability: Availability
  updatedAt: Instant
  """The others in its category, newest first: what a buyer of this one also looks at. Loaded once for a whole page."""
  related: [Product] @cost(base: 2)
}

"""Someone who works here. The directory, as the identity provider and HR agree on it."""
entity Person implements Item @cache(maxAge: 5m, scope: public) {
  id: ID
  name: String
  title: String
  department: String
  email: String
  location: String
  updatedAt: Instant
  """What they have written, newest first."""
  articles: [Article] @cost(base: 2)
  """The rest of their department."""
  colleagues: [Person] @cost(base: 2)
}

"""A page of the knowledge base: a runbook, a policy, a note someone took the trouble to write down."""
entity Article implements Item @cache(maxAge: 60s, scope: public) {
  id: ID
  name: String
  slug: String
  summary: String
  tags: [String]
  author: Person?
  """The full text. Long, and not needed on a list, so it arrives in a later frame unless the shape asks for it eagerly."""
  body: String @lazy
  """Bumped on every edit. Send it back as ifVersion so an edit cannot land on top of someone else's."""
  version: Int @version
  updatedAt: Instant
  """Who wrote the current version: the author until someone edits it."""
  editor: Person?
}

"""
What an article was before an edit. One is kept on every edit, so nothing is rewritten in place and any version
can be read again or put back. `version` is the number the article had when this was its text.
"""
entity ArticleRevision @cache(maxAge: 60s, scope: public) {
  id: ID
  articleId: ID
  version: Int
  name: String
  summary: String
  tags: [String]
  """The text as it was. Long, and not needed on a list, so it arrives when a shape asks for it."""
  body: String @lazy
  """Who wrote that version."""
  editor: Person?
  at: Instant
}

"""
A file someone kept in the documents service, as far as its text is searchable here. The bytes stay there; `url` is
where they are, and the documents service decides who may read them. The text arrives through the platform's queue:
keeping a document puts an extract-text job on it, and this service takes the job.
"""
entity File implements Item @cache(maxAge: 60s, scope: private) {
  id: ID
  name: String
  projectId: ID
  contentType: String
  size: Int @unit("bytes")
  """The document's path in the documents service. A page reaches it under that service's base."""
  url: String
  """The first lines of the text, for a result to show."""
  excerpt: String
  """The document's version this text was taken from."""
  version: Int
  updatedAt: Instant
}

"""
Named views: what a product is when nobody says otherwise, and the card a list shows. A shape spreads one with
`...Product.card`, and a caller that sends no shape gets `default`. Renaming or removing one is a breaking change
that `rayfold check` refuses.
"""
view Product.default = { id name sku price availability updatedAt }
view Product.card = { ...Product.default category summary }
view Person.default = { id name title department email location updatedAt }
view Person.card = { ...Person.default articles { id slug name } }

"""What a search finds. A shape names what it wants of each kind: `{ ...on Product { sku } ...on Person { title } }`."""
union Hit = Product | Person | Article | File

enum Kind { product, person, article, file }

error NotFound { id: ID }

"""Everything matching a phrase, whatever kind of thing it is, best match first."""
query search(q: String @range(min: 1, max: 200), page: PageArgs = { first: 20 }): Page<Hit>
  @allow(read: viewer != null) @cost(base: 5, perItem: 2) @live(false)

"""Leaf through the catalogue: one kind, or all of them, most recently changed first. Numbered pages."""
query items(kind: Kind?, page: PageArgs = { first: 12 }): Page<Item>
  @page(offset) @allow(read: viewer != null) @cost(base: 2, perItem: 1)

query article(slug: String): Article? @allow(read: viewer != null) @http(method: GET, path: "/articles/{slug}")
"""Every earlier version of an article, newest first. The current one is the article itself."""
query articleRevisions(id: ID, page: PageArgs = { first: 20 }): Page<ArticleRevision> @allow(read: viewer != null) @cost(base: 1, perItem: 1)
query product(id: ID): Product? @allow(read: viewer != null) @http(method: GET, path: "/products/{id}")
query person(id: ID): Person? @allow(read: viewer != null) @http(method: GET, path: "/people/{id}")

"""Write or rewrite an article. With `id`, an edit — send `ifVersion`; without, a new page under a fresh slug."""
command writeArticle(id: ID?, name: String @range(min: 1, max: 160), summary: String @range(max: 300), body: String @range(min: 1, max: 50000), tags: [String] = []): Article
  throws NotFound
  @allow(write: viewer != null) @simulate
  @http(method: POST, path: "/articles", body: "*", location: "/articles/{slug}")
